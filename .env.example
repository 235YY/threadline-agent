# Default mode does not call a model or connect QQ.
BRAIN_LIVE=0
BRAIN_PORT=8787
BRAIN_HEARTBEAT_MS=0
# Set only when intentionally enabling the existing affect engine.
JY_AFFECT=0
JY_AFFECT_FUSION=0
# JY_AFFECT_PYTHON=python3
# Standard credentials use the Windows DPAPI helper; see docs/CONFIGURATION.md.
# For separately authorized live operation only:
# JY_LIVE_CONFIRM=YES
# BRAIN_LEDGER=_local/requests.json
# JY_OFFICIAL_USAGE_TOKEN=
# QQ_UIN=
# QQ_OWNER=
# SNOWLUMA_HOME=
# QQ_SDK_MODULE=
# JY_LEGACY_BRIDGE_ROOT=
